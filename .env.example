# Copy to .env for local Docker Compose. Never commit real credentials.
POSTGRES_DB=rag_system
POSTGRES_USER=admin
DB_PASSWORD=replace-with-a-strong-local-password
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/rag_system
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION_MS=86400000
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant
INTERNAL_API_KEY=replace-with-a-long-random-service-key
PYTHON_SERVICE_URL=http://python-ai-service:8000
REDIS_HOST=redis
REDIS_PORT=6379
CHROMA_DB_PATH=/data/chroma
CHROMA_COLLECTION_NAME=educational_documents
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=12MB
VITE_API_BASE=/api
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
